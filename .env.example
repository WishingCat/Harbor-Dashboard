# Local data directory. Docker Compose overrides this with /app/data.
HARBOR_DATA_DIR=./data

# First-run account snapshot directory. Only used when the data directory has
# no database yet; an existing database is never overwritten.
HARBOR_BOOTSTRAP_DIR=./deploy/bootstrap

# Initialize two temporary tasks in ProjectAA; leave PaperBenchX empty.
# Set false before the first start to create an empty workspace.
HARBOR_SEED_DEMO=true

# Optional externally reachable platform URL for links returned by the Agent API.
# If empty, responses use the current HTTP request's base URL.
HARBOR_PUBLIC_URL=

# Shared platform translation. Users never need to supply their own key.
# Managed mode reads only server environment values and disables UI editing.
TRANSLATION_MANAGED=true
TRANSLATION_PROVIDER=DeepSeek
DEEPSEEK_API_KEY=
TRANSLATION_API_KEY=
TRANSLATION_BASE_URL=https://api.deepseek.com
TRANSLATION_MODEL=deepseek-flash
# Also send this to a DeepSeek-compatible gateway using a custom hostname.
TRANSLATION_THINKING=disabled
# False connects directly; true respects HTTP(S)_PROXY / ALL_PROXY on the server.
TRANSLATION_TRUST_ENV=false

# Set true when serving the site over HTTPS in production.
# Keep false for local http://localhost development.
COOKIE_SECURE=false
